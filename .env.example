# Kopieer naar .env en vul in. .env wordt NIET gecommit.

# Poorten
FRONTEND_PORT=4200
BACKEND_PORT=8000
MONGO_PORT=27017
MONGO_EXPRESS_PORT=8081

# MongoDB
MONGO_DB=taxintel
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me-root
MONGO_APP_USER=taxintel_app
MONGO_APP_PASSWORD=change-me-app

# mongo-express (alleen met --profile tools)
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=change-me-express

# Externe API's
GOOGLE_MAPS_API_KEY=
EVENTS_API_KEY=
DELIJN_API_KEY=
ILINE_API_KEY=

# iRail (NMBS-treindata, geen key nodig) - zie README
# IRAIL_STATIONS is een lijst station-ID's, gescheiden door komma's, zonder spaties en zonder aanhalingstekens.
# Leeg = ingebouwde lijst. Een paar voorbeelden:
#   Alleen Antwerpen-Centraal:             BE.NMBS.008821006
#   Centraal en Berchem (de twee drukste): BE.NMBS.008821006,BE.NMBS.008821121
# Hieronder: Antwerpen stad (Centraal, Berchem, Zuid, Luchtbal, Noorderdokken, Linkeroever)
IRAIL_STATIONS=BE.NMBS.008821006,BE.NMBS.008821121,BE.NMBS.008821196,BE.NMBS.008821063,BE.NMBS.008821089,BE.NMBS.008894839
# Automatisch ophalen vanuit de backend elke N minuten (0 = uit)
IRAIL_COLLECT_EVERY_MIN=15
# iRail vraagt een herkenbare User-Agent met contactinfo
IRAIL_USER_AGENT=
